---
import Base from '../layouts/Base.astro';
import { REPO } from '../data/site';
const lanes = [
  { tag: 'Now', cls: '', t: 'Proving the new pieces', items: ['Container mode on real Docker and Podman', 'S3-compatible providers in the wild', 'Building the desktop app for Linux and macOS', 'Release candidates on Linux and macOS'] },
  { tag: 'Next', cls: 'next', t: 'Towards 1.0', items: ['An external security review', 'A 20-minute release-profile soak and a first signed release', 'Visual baselines confirmed on CI'] },
  { tag: 'Later', cls: 'later', t: 'Bigger ideas', items: ['Event workflows and multi-node', 'Extensions and an SDK', 'Public status pages', 'Other games'] },
];
---
<Base title="Roadmap" description="Where Moss is heading.">
  <div class="wrap page">
    <div class="prose" style="max-width:none">
      <span class="kicker">Roadmap</span>
      <h1>Where Moss is heading</h1>
      <p class="lede">Plans change with feedback. The milestone table is in the <a href={`${REPO}#roadmap`} rel="noopener">README</a>; ideas and votes go in <a href={`${REPO}/issues`} rel="noopener">issues</a>.</p>
    </div>
    <div class="lanes">
      {lanes.map((l) => <div class="lane"><span class={`tag ${l.cls}`}>{l.tag}</span><h3>{l.t}</h3><ul>{l.items.map((i) => <li>{i}</li>)}</ul></div>)}
    </div>
  </div>
</Base>
